<?xml version="1.0" encoding="utf-8"?>
<!--
  Splash-screen icon: the unified Solina icon mark (progress ring + play triangle), tinted,
  on a 108dp canvas so it lands inside the splash icon's safe circle.

  PixelPlayerSplash reads this exact drawable to draw its first frame, so the system splash
  hands over to the animated one without a jump. It must keep the ring (body) path first and
  the play triangle (the animated "note") path last. Both are plain filled paths.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:tint="@color/splash_glyph"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:pathData="M54,26.5a27.5,27.5 0,1 1,0 55a27.5,27.5 0,1 1,0 -55z M54,31.5a22.5,22.5 0,1 0,0 45a22.5,22.5 0,1 0,0 -45z"
        android:fillColor="#FFFFFF" />
    <path
        android:pathData="M48.5,40.2L69.6,52.2Q72.4,54 69.6,55.8L48.5,67.8Q46,69.2 46,66.4V41.6Q46,38.8 48.5,40.2z"
        android:fillColor="#FFFFFF" />
</vector>
